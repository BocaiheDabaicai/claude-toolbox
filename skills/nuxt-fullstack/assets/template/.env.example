# PostgreSQL 连接串（Nuxt 运行时与 drizzle-kit / seed 共用）
# 一个项目一个独立 database，例如 app_crm
NUXT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app___PROJECT_DB__

# 会话签名密钥：至少 32 位随机字符，生成示例：
#   openssl rand -base64 48
NUXT_SESSION_SECRET=replace-with-at-least-32-random-characters

# 会话 Cookie 名称（多个项目同域部署时可区分）
NUXT_SESSION_COOKIE_NAME=__PROJECT_SLUG___session

# 生产环境默认 Secure Cookie；如果服务器暂时只有 HTTP，可设为 false
NUXT_PUBLIC_SECURE_COOKIES=true

# 界面显示名称（含空格/中文时用引号）
NUXT_PUBLIC_APP_NAME="__PROJECT_TITLE__"

# 首次 seed 的管理员账号（执行 pnpm db:seed 使用）
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
